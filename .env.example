# ==========================================
# Configuración del Bot de Discord
# ==========================================
# Token de tu bot obtenido desde Discord Developer Portal
DISCORD_BOT_TOKEN=tu_token_aqui

# Tu Discord User ID personal (para restringir el control exclusivo a ti)
# En Discord: Ajustes -> Avanzado -> Modo Desarrollador -> Clic derecho en tu perfil -> Copiar ID
DISCORD_OWNER_ID=123456789012345678

# Prefijo para comandos de texto tradicionales (opcional, también responde en DMs o menciones)
DISCORD_PREFIX=!

# Canal de texto permitido (opcional: déjalo vacío para permitir cualquier DM o canal donde estés tú)
DISCORD_ALLOWED_CHANNEL_ID=

# ==========================================
# Configuración de Ollama (IA Local)
# ==========================================
# Dirección del servidor de Ollama
OLLAMA_HOST=http://localhost:11434

# Nombre del modelo instalado en tu Ollama (ej. qwen3:8b, qwen2.5:8b, llama3.1:8b)
OLLAMA_MODEL=qwen3:8b

# Temperatura para el modelo (0.0 a 1.0 - valores bajos son más precisos para ejecutar comandos)
OLLAMA_TEMPERATURE=0.2

# ==========================================
# Personalidad y Sistema
# ==========================================
ASSISTANT_NAME=Aigis
LOG_LEVEL=INFO
